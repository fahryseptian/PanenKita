# ============================================================
# PanenKita — platform katalog panen untuk KWT
# Copy to kwt/.env
# ============================================================

# --- Database (Neon) ---
# Buat database gratis di https://neon.tech
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Better Auth ---
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# URL publik aplikasi (tanpa trailing slash)
BETTER_AUTH_URL=http://localhost:3000

# --- Google OAuth (opsional; kosongkan untuk menyembunyikan login Google) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Kode akses signup pilot (invite-only); kosongkan untuk signup terbuka ---
PILOT_ACCESS_CODE=

# --- WhatsApp via Fonnte (Fase 2; kosongkan untuk menonaktifkan) ---
# Token device dari https://console.fonnte.com
FONTE_TOKEN=

# --- Cron recompute harga (opsional) ---
# Generate: openssl rand -hex 32 — dipakai header x-cron-secret di /api/pricing/recompute
CRON_SHARED_SECRET=

# --- Midtrans Snap (Fase 3; kosongkan untuk menonaktifkan pembayaran online) ---
# Dashboard https://dashboard.sandbox.midtrans.com -> Settings -> Access keys
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# --- Publik ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PRODUCT_NAME=PanenKita
